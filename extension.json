{
  "name": "ServerSplitter",
  "identifier": "serversplitter",
  "version": "1.0.18",
  "description": "Divide servidores de Pterodactyl en varios servidores hijos de forma segura, con bloqueos, reglas de eggs, limites minimos e integracion con WHMCS y Paymenter.",
  "author": "Waise Team",
  "target": {
    "panel": ">=1.11.0 <2.0.0",
    "php": ">=8.1",
    "laravel": "^10.0"
  },
  "requires_blueprint": false,
  "install": {
    "target_dir": "app/Extensions/ServerSplitter",
    "assets_dir": "public/extensions/serversplitter",
    "provider": "Pterodactyl\\Extensions\\ServerSplitter\\Providers\\ServerSplitterServiceProvider"
  },
  "commands": [
    "serversplitter install",
    "serversplitter update",
    "serversplitter uninstall",
    "serversplitter status",
    "serversplitter apikey"
  ]
}