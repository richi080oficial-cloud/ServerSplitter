#!/usr/bin/env bash
#
# Comando global de ServerSplitter.
# Delega en el gestor (/opt/serversplitter/serversplitter.sh) si está disponible
# y, en su defecto, en el instalador guardado por la propia extensión.
#
set -Eeuo pipefail

SRC_DIR="${SRC_DIR:-/opt/serversplitter}"
STATE_DIR="/usr/local/share/serversplitter"
MANAGER="${SRC_DIR}/serversplitter.sh"
INSTALLER="${STATE_DIR}/source/scripts/addon-install.sh"

# Ejecución directa desde el repositorio clonado (./bin/serversplitter ...).
LOCAL_MANAGER="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/serversplitter.sh"

if [ -f "$MANAGER" ]; then
    exec bash "$MANAGER" "$@"
fi

if [ -f "$LOCAL_MANAGER" ]; then
    exec bash "$LOCAL_MANAGER" "$@"
fi

if [ -f "$INSTALLER" ]; then
    exec bash "$INSTALLER" "$@"
fi

echo "[serversplitter] No se encontró el gestor en ${MANAGER} ni el instalador en ${INSTALLER}." >&2
echo "[serversplitter] Reinstala con:" >&2
echo "  bash <(curl -sSL https://raw.githubusercontent.com/waise-team/ServerSplitter/main/install.sh) install" >&2
exit 1